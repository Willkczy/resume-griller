# Resume Griller Environment Configuration

# App Settings
DEBUG=true

# LLM Configuration
# Active service selection supports API mode. LLM_MODE=local is present in settings
# but automatic local LoRA loading is not wired into the current factory.
LLM_MODE=api
LLM_PROVIDER=groq

# API Keys (填入你的 key)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Model names
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Custom/Hybrid execution endpoint
CUSTOM_MODEL_ENABLED=false
CUSTOM_MODEL_URL=http://localhost:8001/v1
CUSTOM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2
CUSTOM_MODEL_TIMEOUT=120

# Parsed resume storage (active path for new uploads)
PARSED_RESUME_DIR=./data/parsed_resumes

# Legacy ChromaDB compatibility (new uploads do not create embeddings)
CHROMA_PERSIST_DIR=./data/chromadb
EMBEDDING_MODEL=all-MiniLM-L6-v2

# File Upload
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=10485760

# Voice Services
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Voice is optional and is not part of the verified baseline. The current root
# dependency set does not include the ElevenLabs SDK; keep disabled until roadmap M0
# resolves the dependency/default contract.
VOICE_ENABLED=false
STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs


# DATABASE_URL is reserved for future metadata persistence and is not used by the
# active application. CHECKPOINT_DB_PATH is the active LangGraph state store.
DATABASE_URL=sqlite+aiosqlite:///./data/resume_griller.db
CHECKPOINT_DB_PATH=./data/interview_checkpoints.db
